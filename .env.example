# Copy to .env and adjust. .env is gitignored. No secrets belong here;
# database passwords live in files under XPM_SECRETS_DIR (scripts/init-secrets.sh).

# Reserved LAN address of the workstation. The dashboard is published only here.
XPM_HOST=10.0.0.125
XPM_BIND_ADDR=10.0.0.125
XPM_PUBLIC_ORIGIN=https://10.0.0.125

# Persistent data (PostgreSQL, Caddy CA/certificates; later protected files and backups).
XPM_DATA_DIR=./data
XPM_SECRETS_DIR=./secrets

# Fictional demo data and demo job types. Turn off before processing real data.
XPM_SAMPLE_DATA=true

XPM_SESSION_TTL_HOURS=12
XPM_SESSION_IDLE_MINUTES=60

# Gmail intake (Milestone 3). Mail to these addresses/aliases is flagged as
# likely customer correspondence. All other new mail is still read for the
# briefing, read-only.
XPM_CUSTOMER_ADDRESSES=info@questalinastudio.com
XPM_GMAIL_POLL_SECONDS=60
